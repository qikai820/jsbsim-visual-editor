{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/main/.tauri/tauri.conf.json",
  "productName": "JSBSim Visual Editor",
  "version": "1.0.0",
  "identifier": "com.jsbsim.visual-editor",
  "build": {
    "beforeDevCommand": "npm run dev:client",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "JSBSim Visual Editor",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png"
    ]
  }
}
