 void MainWindow::checkAllCurvesFromLayout(const QDomElement& root)
 {
+  if (_jsbsim_integrated)
+  {
+    // Native PlotJuggler layouts store plots under Tab/Container/DockSplitter/
+    // DockArea, not directly under plotmatrix. Restore empty series before the
+    // plot widgets load their curves and before JSBSim starts streaming.
+    std::set<std::string> numeric_curves;
+    std::set<std::string> scatter_curves;
+    QDomNodeList plots = root.elementsByTagName("plot");
+    for (int i = 0; i < plots.count(); ++i)
+    {
+      QDomElement plot = plots.at(i).toElement();
+      bool is_xy = plot.attribute("mode") == "XYPlot";
+      for (QDomElement curve = plot.firstChildElement("curve"); !curve.isNull();
+           curve = curve.nextSiblingElement("curve"))
+      {
+        if (curve.hasAttribute("curve_x") && curve.hasAttribute("curve_y"))
+        {
+          numeric_curves.insert(curve.attribute("curve_x").toStdString());
+          numeric_curves.insert(curve.attribute("curve_y").toStdString());
+        }
+        else if (is_xy)
+        {
+          scatter_curves.insert(curve.attribute("name").toStdString());
+        }
+        else
+        {
+          numeric_curves.insert(curve.attribute("name").toStdString());
+        }
+      }
+    }
+
+    for (const auto& name : numeric_curves)
+    {
+      if (!name.empty() && _mapped_plot_data.numeric.count(name) == 0)
+      {
+        _mapped_plot_data.addNumeric(name);
+        _curvelist_widget->addCurve(name);
+      }
+    }
+    for (const auto& name : scatter_curves)
+    {
+      if (!name.empty() && _mapped_plot_data.scatter_xy.count(name) == 0)
+      {
+        _mapped_plot_data.addScatterXY(name);
+        _curvelist_widget->addCurve(name);
+      }
+    }
+    _curvelist_widget->refreshColumns();
+    return;
+  }
+
   std::set<std::string> curves;
 
