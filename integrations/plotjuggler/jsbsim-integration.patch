+void MainWindow::saveIntegratedLayout()
+{
+  if (_auto_layout_path.isEmpty())
+  {
+    return;
+  }
+
+  QDomDocument doc = xmlSaveState();
+  QDomElement root = doc.documentElement();
+  root.appendChild(savePluginState(doc));
+
+  QDomElement custom_equations = doc.createElement("customMathEquations");
+  for (const auto& custom_it : _transform_functions)
+  {
+    custom_it.second->xmlSaveState(doc, custom_equations);
+  }
+  root.appendChild(custom_equations);
+
+  QByteArray xml = doc.toByteArray(2);
+  if (xml == _last_auto_layout)
+  {
+    return;
+  }
+  QSaveFile file(_auto_layout_path);
+  if (!file.open(QIODevice::WriteOnly) || file.write(xml) != xml.size() || !file.commit())
+  {
+    qWarning() << "Could not save JSBSim PlotJuggler layout:" << file.errorString();
+    return;
+  }
+  _last_auto_layout = xml;
+}
